{
    "_comment": "Inference spec for #012's AR-argmax stack on top of OnsetAugmentedDetector. The per-eval InferCorpusHook uses predict_from_features against the dataset's pre-cached 84-row features (audio_sampler bypassed); standalone cli.infer + cli.infer_corpus instantiate audio_sampler to compute 84-row features from raw audio. n_mels here matches the dataset's MelOnsetSamplerConfig (80 mel + 4 onset subbands = 84 rows).",
    "checkpoint": "osu/taiko2/runs/exp_012_onset_channels/checkpoints/best.pt",
    "predictor": {
        "__class__": "osu.taiko2.inference.autoregressive.predictor:AutoregressivePredictor",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.predictor:AutoregressivePredictorConfig",
            "hop_bins_on_stop": 20,
            "max_events": 10000,
            "min_onset_gap_bins": 1,
            "default_kind": "DON"
        }
    },
    "decoder": {
        "__class__": "osu.taiko2.inference.autoregressive.decoders:ArgmaxDecoder",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.decoders:ArgmaxDecoderConfig",
            "b_pred": 500,
            "top_k_log": 5
        }
    },
    "input_builder": {
        "__class__": "osu.taiko2.inference.autoregressive.builders:DetectionARInputBuilder",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.builders:DetectionARBuilderConfig",
            "a_bins": 500,
            "b_bins": 500,
            "c_events": 128
        }
    },
    "audio_sampler": {
        "__class__": "osu.taiko2.samplers.mel_onset:MelOnsetSampler",
        "config": {
            "__class__": "osu.taiko2.samplers.mel_onset:MelOnsetSamplerConfig",
            "sample_rate": 22000,
            "n_fft": 2048,
            "hop_divisor": 200,
            "n_mels": 80,
            "f_min": 20.0,
            "f_max": 8000.0,
            "power": 2.0,
            "top_db": 80.0,
            "n_onset_subbands": 4,
            "onset_norm_percentile": 99.0,
            "onset_target_db_range": [-80.0, 0.0]
        }
    },
    "event_sampler": {
        "__class__": "osu.taiko2.samplers.event:FixedRateEventSampler",
        "config": {
            "__class__": "osu.taiko2.domain.dataset:EventSamplerConfig",
            "divisor": 200
        }
    }
}
