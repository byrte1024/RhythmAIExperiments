            "b_pred": 500,
            "decode_threshold": 0.5,
            "nms_kernel": 1,
            "stop_hop_bins": 20,
            "min_emit_gap_bins": 1,
            "top_k_log": 5,
            "sampler_config": {
                "__class__": "osu.taiko2.diffusion.samplers:DDIMSamplerConfig",
                "n_inference_steps": 16,
