{
    "_comment": "#017b data: identical to #017/#016 — d_events=100 so the framewise adapter can see all future onsets in the 500-bin (2.5s) prediction window.",
    "__class__": "osu.taiko2.data_samplers.detection:TaikoDetectionSamplerConfig",
    "batch_size": 64,
    "a_bins": 500,
    "b_bins": 500,
    "c_events": 128,
    "d_events": 100,
    "min_cursor_bin": 6000,
    "allowed_overlap_forward": 0,
    "allowed_overlap_back": 0,
    "subsample": 1,
    "split_ratios": [["train", 0.9], ["val", 0.1]],
    "split_seed": 42
}
