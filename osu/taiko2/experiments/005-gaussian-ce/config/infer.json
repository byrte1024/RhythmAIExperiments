{
    "_comment": "Inference spec for exp 002's AR-argmax stack. Points at best.pt by default — use --checkpoint to override with a specific eval_{step}/checkpoint.pt. All five components are resolvable `module:Class` strings — swap any of them to try a different decoder / builder / sampler without touching the CLI.",
    "checkpoint": "osu/taiko2/runs/exp_002_exp45_full/checkpoints/best.pt",
    "predictor": {
        "__class__": "osu.taiko2.inference.autoregressive.predictor:AutoregressivePredictor",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.predictor:AutoregressivePredictorConfig",
            "hop_bins_on_stop": 20,
            "max_events": 10000,
            "min_onset_gap_bins": 1,
            "default_kind": "DON"
        }
    },
    "decoder": {
        "__class__": "osu.taiko2.inference.autoregressive.decoders:ArgmaxDecoder",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.decoders:ArgmaxDecoderConfig",
            "b_pred": 500,
            "top_k_log": 5
        }
    },
    "input_builder": {
        "__class__": "osu.taiko2.inference.autoregressive.builders:DetectionARInputBuilder",
        "config": {
            "__class__": "osu.taiko2.inference.autoregressive.builders:DetectionARBuilderConfig",
            "a_bins": 500,
            "b_bins": 500,
            "c_events": 128
        }
    },
    "audio_sampler": {
        "__class__": "osu.taiko2.samplers.mel:MelSampler",
        "config": {
            "__class__": "osu.taiko2.domain.dataset:MelSamplerConfig",
            "sample_rate": 22000,
            "n_fft": 2048,
            "hop_divisor": 200,
            "n_mels": 80,
            "f_min": 20.0,
            "f_max": 8000.0,
            "power": 2.0,
            "top_db": 80.0
        }
    },
    "event_sampler": {
        "__class__": "osu.taiko2.samplers.event:FixedRateEventSampler",
        "config": {
            "__class__": "osu.taiko2.domain.dataset:EventSamplerConfig",
            "divisor": 200
        }
    }
}
